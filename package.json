{
  "name": "iitk-bicycle",
  "version": "0.1.0",
  "private": true,
  "description": "Campus-owned bicycle pool for IIT Kanpur: rider app, admin console and Supabase backend.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @iitk-bicycle/admin dev",
    "dev:mobile": "pnpm --filter @iitk-bicycle/mobile start",
    "dev:mobile:web": "pnpm --filter @iitk-bicycle/mobile web",
    "build:admin": "pnpm --filter @iitk-bicycle/admin build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.120.0",
    "typescript": "~6.0.3"
  }
}
